##############################################################################
# FieldCheck AI — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` file — it holds live API keys and secrets.
##############################################################################

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="FieldCheck AI"
APP_ENV=development                 # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins. Use "*" only in local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret used to sign/validate internal tokens (generate with `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Simple shared-secret API key required on write endpoints (optional; leave
# blank to disable). Sent by clients as `X-API-Key`.
INTERNAL_API_KEY=

# Basic rate limiting scaffolding (requests / window per client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, zero-config, good for the MVP/demo):
DATABASE_URL=sqlite+aiosqlite:///./fieldcheck.db

# PostgreSQL (production example — uncomment and configure):
# DATABASE_URL=postgresql+asyncpg://fieldcheck:fieldcheck@db:5432/fieldcheck

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_MIME_TYPES=image/jpeg,image/png

# ---------------------------------------------------------------------------
# Async processing
# ---------------------------------------------------------------------------
# If USE_CELERY=true, a Redis-backed Celery worker processes inspections.
# If false, FastAPI BackgroundTasks handles them in-process (no Redis needed).
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Vision AI provider
# ---------------------------------------------------------------------------
# Choose "openai" (GPT-4o) or "anthropic" (Claude 3.5 Sonnet)
VISION_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_VISION_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# Vision API call tuning
VISION_TIMEOUT_SECONDS=45
VISION_MAX_RETRIES=3

# If true and no API key is configured, the vision engine returns a
# deterministic mock response so the app is runnable/demoable offline.
VISION_MOCK_MODE=true

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
REPORT_OUTPUT_DIR=./output_reports
COMPANY_NAME="FieldCheck AI Demo Co."

# ---------------------------------------------------------------------------
# Email (inspection report delivery — used by the web + Android upload flows)
# ---------------------------------------------------------------------------
# If true (default), no real SMTP connection is made. Each "sent" email is
# instead written to REPORT_OUTPUT_DIR/mock_outbox/ as an .html file, so the
# whole login -> upload -> "email me the report" flow is demoable offline,
# exactly like VISION_MOCK_MODE for the vision AI.
EMAIL_MOCK_MODE=true

# Real SMTP settings (only used when EMAIL_MOCK_MODE=false). Example values
# for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your
# address, SMTP_PASSWORD=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@fieldcheck.ai
SMTP_FROM_NAME="FieldCheck AI"
